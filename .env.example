# OpenDots template: the UI opens in setup state until these fields are configured.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it owns the persistent Intelligence conversations.
OWNER_ID=opendots-owner
# npm run dev allows http://127.0.0.1:5173; override for a different exact origin.
# APP_ORIGIN=http://127.0.0.1:5173
# Extra host names the browser may use (comma-separated), e.g. a LAN IP or hostname.
# ALLOWED_HOSTS=
# An external HOST binding needs APP_ORIGIN, ALLOWED_HOSTS, or OWNER_TOKEN.

# Sign-in: the first run creates the admin user and asks for a new password at first login.
# Its password is ADMIN_INITIAL_PASSWORD if set; otherwise admin/admin on a loopback HOST,
# or a random one-time password printed once to the server log on an external HOST
# (e.g. Docker's 0.0.0.0).
# ADMIN_INITIAL_PASSWORD=
# Set temporarily to reset the admin password at startup, then remove it.
# ADMIN_PASSWORD_RESET=
# Session cookie Secure flag: auto (secure when APP_ORIGIN is https, else per request
# via HTTPS or X-Forwarded-Proto), true, or false.
# COOKIE_SECURE=auto
# Behind exactly one reverse proxy you control: rate-limit sign-in by the right-most
# X-Forwarded-For address instead of the proxy's. Leave off when clients connect directly.
# TRUST_PROXY=false
# Optional Bearer token (24+ characters) for scripts and automation.
# OWNER_TOKEN=

# Optional: CopilotKit Intelligence for hosted threads, Slack and Learning.
# Without it, conversations are stored locally in DATABASE_PATH.
INTELLIGENCE_API_KEY=
# INTELLIGENCE_API_URL=
# INTELLIGENCE_WS_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Output token cap for chat-completions models (default 16000, clamped 1000-200000).
# Does not apply to the ChatGPT/Codex provider.
# MODEL_MAX_OUTPUT_TOKENS=16000
# Reasoning effort for both providers: minimal, low, medium, or high. Unset uses the
# model's default; an invalid value stops startup.
# MODEL_REASONING_EFFORT=
# Optional encryption key for stored provider sign-ins (ChatGPT). Keep it stable.
CREDENTIALS_SECRET=
# Default model for the ChatGPT subscription provider.
# OPENAI_CODEX_MODEL=gpt-5.5
# Time budget for one agent turn in seconds (30-1800, default 300). Scheduled tasks
# get 15 s more; reverse-proxy read timeouts should be at least this long.
# AGENT_RUN_TIMEOUT_SECONDS=300

# Optional isolated read-only public-page browser for WEB_SEARCH_PROVIDER=browser.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional realtime speech; compute uses the same configured Intelligence thread.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin
# ChatGPT-subscription calls (unofficial; used when signed in with ChatGPT).
VOICE_CHATGPT_MODEL=
VOICE_CHATGPT_VOICE=

# Optional managed Slack channel; see docs/SETUP.md#slack.
# Match the managed declaration name, not a Slack #conversation name.
# OpenTag calls this INTELLIGENCE_CHANNEL_NAME; OpenDots uses SLACK_CHANNEL_NAME.
# Allowlist both the Slack workspace and explicit Slack user IDs.
SLACK_CHANNEL_NAME=
SLACK_TEAM_ID=
SLACK_USER_IDS=
# SLACK_DOT_ID= (defaults to the initial Dot)

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# Image each computer runs; the default adds git, Python, and build tools.
# COMPUTER_IMAGE=opendots-computer-dev:b6932d3
# ENGINE_SOCKET=/var/run/docker.sock

# Public-web provider. parallel (default), browser (URL-only), or disabled.
# Queries and selected URLs are sent to Parallel; sample mode makes no provider calls.
WEB_SEARCH_PROVIDER=parallel
# Optional Bearer key for production/higher limits; anonymous MCP supports light use.
PARALLEL_API_KEY=
